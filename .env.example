# Branded canonical domain; do not change DNS without consent
NEXT_PUBLIC_SITE_URL=https://hawinetcoffee.com

# KEEP FALSE while WordPress serves the branded domain.
# Enable only when the Next.js release is accessible on the canonical domain,
# redirects/canonicals are reviewed and Search Console ownership verified.
HAWINET_ENABLE_INDEXING=false

# Paste Google's verification content into Vercel Environment Variables, not Git.
GOOGLE_SITE_VERIFICATION=

# Contact email provider setup
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=info@hawinetcoffee.com

# Optional GA4 measurement, only loads after visitor consent
NEXT_PUBLIC_GA4_ID=
